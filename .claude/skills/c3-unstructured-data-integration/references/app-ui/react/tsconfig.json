{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      // No `@/*` alias. Shipped `src/` uses package-relative imports ONLY, so it type-checks under
      // any consumer's tsconfig regardless of their own `@/*` mapping. Deliberately absent so a
      // reintroduced `@/` specifier fails `tsc --noEmit` here (and in vite) in-repo instead of
      // shipping and breaking every downstream consumer. Enforced by scripts/verify-pack-isolation.sh.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "tests"],
  "exclude": ["tests", "**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

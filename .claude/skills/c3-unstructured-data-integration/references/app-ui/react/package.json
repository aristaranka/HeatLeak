{
  "name": "@c3/doc-ai-documents-ui",
  "private": false,
  "version": "0.1.0",
  "description": "Self-contained Document AI (Documents) React library — a curated public API (DocumentsPage/DataPage + data-access helpers) that ships raw TS source for consumption by a host SPA.",
  "publishConfig": {
    "registry": "https://us-npm.pkg.dev/cicd-360621/npm/"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./globals.css": "./src/globals.css",
    "./styles/theme.css": "./src/tailwind/c3TailwindTheme.css",
    "./styles/utilities.css": "./src/tailwind/c3CustomUtilities.css",
    "./styles/app.css": "./src/App.css",
    "./*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "style": "./src/globals.css",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "!src/**/__mocks__/**"
  ],
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit && eslint --ext .js,.ts,.tsx src",
    "verify:pack": "bash scripts/verify-pack-isolation.sh",
    "build": "npm run check && npm run verify:pack && npm run build:app",
    "build:lib": "tsc --noEmit -p tsconfig.build.json && npm run verify:pack",
    "build:app": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint --ext .js,.ts,.tsx src",
    "lint:fix": "eslint --ext .js,.ts,.tsx --fix src"
  },
  "peerDependencies": {
    "i18next": ">=25 <27",
    "react": "^18.2.0 || ^19.0.0",

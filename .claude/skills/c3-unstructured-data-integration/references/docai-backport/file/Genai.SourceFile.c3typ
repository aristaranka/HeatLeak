/**
 * BACKPORT FROM 8.12 (develop@f0a321d15f) — remove on 8.12 upgrade (GEN-21401).
 *
 * Remix of {@link Genai.SourceFile} to make {@link #processWithPipeline} and {@link #unprocessWithPipeline}
 * Doc AI-aware.
 *
 * The platform {@link Genai.SourceFile#processWithPipeline} groups files strictly by their collection's
 * {@link Genai.SourceCollection#unstructuredPipeline} and calls that pipeline's {@code run} method. It has
 * no knowledge of the backported {@link Genai.SourceCollection#docAiPipeline} field, so for a DocAI-wired
 * collection ({@code unstructuredPipeline} null, {@code docAiPipeline} set) the stock method finds no
 * pipeline and dispatches nothing — files transition to {@code Processing} but the Doc AI microservice is
 * never called, leaving them stranded. This override closes that gap: files whose collection carries a
 * {@link Genai.DocAiPipeline} are routed to {@link Genai.DocAiPipeline#run}, while any remaining files fall
 * back to the collection's {@link Genai.UnstructuredPipeline} exactly as the platform did. This is the
 * single dispatch entry point the Documents UI and {@link Genai.SourceCollection} sync both rely on.
 *
 * {@link Genai.SourceFile#unprocessWithPipeline} has the identical blind spot on the removal side: the
 * platform version "groups files by their collection's {@code unstructuredPipeline} and unindexes them",
 * so for a DocAI collection it dispatches nothing and files clicked "Unprocess" transition to
 * {@code Removing} (set by the UI) and stay there forever. Removal is pipeline-agnostic — it only needs the
 * target retriever — so this override sidesteps pipeline grouping entirely: it resolves each collection's
 * retriever (from {@link Genai.DocAiPipeline#retrieverId}, defaulting to {@code default-pg}), unindexes via
 * the pipeline-agnostic {@link Genai.SourceFile#unprocess}, and — when not deleting — completes the terminal
 * transition back to {@code Not Indexed} via {@link Genai.SourceFile#handleTransitionToNotIndexed} (the
 * low-level {@code unprocess} only sets a terminal status when {@code shouldTransitionToDeleted} is true).
 */
remix type Genai.SourceFile {

  /**
   * Processes {@link Genai.SourceFile}s using their collection's configured pipeline. Groups the files by
   * collection: those whose collection has a {@link Genai.SourceCollection#docAiPipeline} are dispatched to
   * {@link Genai.DocAiPipeline#run} (the Doc AI microservice); the rest are grouped by
   * {@link Genai.SourceCollection#unstructuredPipeline} and dispatched to {@link Genai.UnstructuredPipeline#run},
   * preserving the platform behavior. Processing is asynchronous and status can be tracked via
   * {@link Genai.SourceFile#status}.
   *
   * @param files
   *        The {@link Genai.SourceFile}s to process.
   */
  processWithPipeline: function(files: ![Genai.SourceFile]) js-rhino

  /**
   * Unprocesses (unindexes) {@link Genai.SourceFile}s. Unlike the platform version — which groups files by
   * their collection's {@link Genai.SourceCollection#unstructuredPipeline} and therefore dispatches nothing
   * for a DocAI-wired collection (leaving files stuck in {@code Removing}) — this override resolves each
   * collection's retriever (from {@link Genai.DocAiPipeline#retrieverId}, defaulting to {@code default-pg})
   * and unindexes directly via {@link Genai.SourceFile#unprocess}. When {@code shouldTransitionToDeleted} is
   * false, it then transitions the files back to {@code Not Indexed} via
   * {@link Genai.SourceFile#handleTransitionToNotIndexed}; when true, {@link Genai.SourceFile#unprocess}
   * transitions them to {@code Deleted}. Unindexing is synchronous within this dispatch.
   *
   * @param files
   *        The {@link Genai.SourceFile}s to unprocess.
   * @param shouldTransitionToDeleted
   *        If true, transitions files to {@code Deleted} after unindexing; otherwise returns them to
   *        {@code Not Indexed}.
   */
  unprocessWithPipeline: function(files: ![Genai.SourceFile], shouldTransitionToDeleted: boolean) js-rhino
}

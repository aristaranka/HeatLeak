/**
 * BACKPORT FROM 8.12 (develop@f0a321d15f) — remove on 8.12 upgrade (GEN-21401).
 *
 * Remix of {@link Genai.SourceCollection} to add the {@link #docAiPipeline} reference so a collection can
 * route processing to the Doc AI microservice instead of the in-app {@link Genai.UnstructuredPipeline} job.
 */
remix type Genai.SourceCollection {

  /**
   * Reference to a {@link Genai.DocAiPipeline} configuration. When set, files in this collection are
   * processed by the Doc AI microservice instead of the in-app {@link Genai.UnstructuredPipeline} job.
   * A collection should have at most one of {@link #unstructuredPipeline} or #docAiPipeline configured.
   */
  docAiPipeline: Genai.DocAiPipeline
}

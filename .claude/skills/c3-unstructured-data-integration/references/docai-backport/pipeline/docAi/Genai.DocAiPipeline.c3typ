/**
 * A pipeline that delegates document processing to the Doc AI microservice. When attached to a
 * {@link Genai.SourceCollection}, {@link #run} transitions files to {@link Genai.SourceFile.StatusEnum#PROCESSING}
 * and kicks off an asynchronous processing job on the microservice, which parses, chunks, embeds, and persists
 * the resulting passages on completion. Files are then transitioned to
 * {@link Genai.SourceFile.StatusEnum#INDEXED} or {@link Genai.SourceFile.StatusEnum#FAILED} by the microservice.
 *
 * A pipeline runs the strategy supplied via the required {@link #strategy} field — either an app-owned custom
 * strategy (Python source stored in a {@link Genai.DocAiStrategy} row) or a named OOTB strategy resolved by the
 * microservice ({@link Genai.DocAiStrategy#ootbName}). The pipeline itself stays mutable and can be repointed at
 * a different strategy at any time; the strategy's source ({@link Genai.DocAiStrategy}) is immutable.
 */
@seed(userUpdatable=true)
entity type Genai.DocAiPipeline mixes SeedData, WithName {

  /**
   * Strategy reference for this pipeline. Can be either the {@link Genai.DocAiStrategy#id} of an
   * app-owned strategy row ({@link Genai.DocAiStrategy}) or the name of a built-in strategy registered
   * in the Doc AI microservice (e.g. {@code passage_level}). At runtime the pipeline first tries to
   * resolve a {@link Genai.DocAiStrategy} row with this id; if found, that row's script source or
   * {@link Genai.DocAiStrategy#ootbName} is used. If no row exists, the value is sent directly to the
   * microservice as a built-in strategy name.
   */
  strategyRef: !string = 'passage_level'

  /**
   * User-facing display name for the strategy. Shown in the UI and can be updated without changing
   * the underlying {@link #strategyRef}.
   */
  strategyDisplayName: string

  /**
   * Per-strategy ingestion configuration (tag/entity extraction) passed to the Doc AI microservice.
   */
  ingestionSettings: json

  /**
   * Target retriever ID that the microservice persists results into.
   */
  retrieverId: string = 'default-pg'

  /**
   * Transitions the files to {@link Genai.SourceFile.StatusEnum#PROCESSING} and kicks off an asynchronous
   * Doc AI processing job. Returns once the job has been submitted; the microservice persists results and
   * updates file statuses on completion.
   *
   * @param files
   *         List of source files to process.
   * @param executeSpec
   *         Optional per-run overrides for the pipeline's settings.
   */
  run: member function(files: ![Genai.SourceFile], executeSpec: Genai.DocAiPipeline.ExecuteSpec) js-rhino

  /**
   * Mints presigned URLs for each file. Files that fail to generate a presigned URL are omitted
   * and fall back to base64 transport.
   */
  _mintPresignedUrls: private function(loadedFiles: ![Genai.SourceFile], ttl: !string): !map<string, string> js-rhino

  /**
   * Builds the manualTags map for the pod payload. Only MANUAL (user-curated) tags are forwarded.
   */
  _buildManualTagsByFile: private function(loadedFiles: ![Genai.SourceFile]): !json js-rhino
}

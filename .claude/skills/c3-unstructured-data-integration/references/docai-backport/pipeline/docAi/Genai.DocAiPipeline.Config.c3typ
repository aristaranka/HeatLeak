/**
 * Configuration for connecting to the Doc AI microservice.
 *
 * The microservice endpoint is not configured here: it is resolved from the platform's
 * {@link Microservice.Config} (see {@link Genai.DocAiPipeline.Api#baseUrl}), which Ops configures per
 * environment.
 */
type Genai.DocAiPipeline.Config mixes Config, Singleton {

  /**
   * When true, the pipeline mints presigned URLs for source files and passes them to the DocAI microservice.
   * The pod streams directly from storage via the presigned URL, avoiding file bytes passing through DocAI.
   * Recommended for large files (>50 MB) or high-volume jobs to reduce memory pressure on DocAI.
   *
   * Requires platform 8.10+ for {@link FileSystem#generatePresignedUrl}. When false (the default), files are
   * transported via inline base64 encoding.
   */
  @config
  usePresignedUrls: boolean = false

  /**
   * TTL for presigned URLs when {@link #usePresignedUrls} is enabled. Use a long TTL since the URL must
   * remain valid through queue wait + processing + retries. Defaults to 24 hours.
   */
  @config
  presignedUrlTtl: string = '24 hours'
}

/**
 * Declarative REST client for the Doc AI microservice, which runs as a separate application on the cluster
 * and exposes its API at `<base>/docai/v1/...`. The microservice processes documents asynchronously and
 * persists the resulting passages on completion, so callers only need to kick off processing.
 */
type Genai.DocAiPipeline.Api mixes REST {

  /**
   * Enqueues asynchronous processing runs (one per file) on the Doc AI microservice. Each parameter is sent as a
   * top-level key of the JSON request body, matching the microservice's `@restful` `process` contract. Exactly one
   * of `strategyName` / `script` must be non-null.
   *
   * The `@rest` client composes the JSON request body from these parameters keyed by name, so each becomes
   * a top-level field the microservice reads directly (`source`, `strategyName`, ...). Do not collapse these
   * into a single `json` param: a lone `@rest(postBody=true)` arg is wrapped under its own name, sending
   * `{ "body": { ... } }` and leaving the microservice with an undefined `source`.
   *
   * @param source           Documents to process: `{ files: [<path>], presignedUrls?: { <path>: <url> } }`.
   *                         `files` is required. `presignedUrls` is an optional map of file path to presigned URL;
   *                         when provided, the pod streams directly from storage via the presigned URL instead of
   *                         base64-encoding file bytes through DocAI. Files without a presignedUrls entry fall back
   *                         to base64 transport. See {@link Genai.DocAiPipeline.Config#usePresignedUrls}.
   * @param retrieverId       Retriever the resulting passages are persisted against.
   * @param sourceApp         Id of the app the microservice reads files from and persists results back to.
   * @param strategyName      OOTB strategy name resolved by the microservice; null when `script` is set.
   * @param script            Inline Python strategy source; null when `strategyName` is set.
   * @param ingestionSettings Optional per-run ingestion overrides.
   * @return `{ jobId, runs: [{ runId, file, status }], rejected: [...] }`.
   */
  @rest(uri='docai/v1/process', method='POST', contentType='application/json')
  process: abstract function(
    source: !json,
    retrieverId: !string,
    sourceApp: !string,
    strategyName: string,
    script: string,
    ingestionSettings: json
  ): json

  /**
   * Lists the OOTB (and any service-registered) strategies the microservice exposes, each with its default
   * ingestion settings. Used by the Data Fusion UI to build the strategy picker: OOTB entries come from here,
   * while app-owned custom strategies are read separately from {@link Genai.DocAiStrategy} / its card.
   *
   * @return `[{ name, description, isCustom, scoped, defaultSettings }]`.
   */
  @rest(uri='docai/v1/strategies/list', method='GET')
  listStrategies: abstract function(): json

  /**
   * Health check endpoint used to determine whether the Doc AI microservice is deployed and reachable.
   *
   * @return the raw HTTP response so callers can inspect the status code.
   */
  @rest(uri='docai/v1/health', method='GET')
  health: abstract function(): HttpResponse

  /**
   * Named-config key for the DocAI microservice in {@link Microservice.Config}. Ops configures the entry under
   * this name per environment. Casing mirrors the microservice type-name convention (e.g. Nexus, ArtifactHub).
   */
  SERVICE_NAME: const string = 'DocAi'

  /**
   * @return the base URL used to reach the Doc AI microservice, read from
   *         {@link Microservice.Config#serviceAppUrl} for {@link #SERVICE_NAME}. Ops configures this per
   *         environment; throws if it is not set.
   */
  baseUrl: function(): !string js-rhino

  /**
   * Configures the client with the base URL and forwards the current user's C3 session token as the
   * `Authorization` header, so the microservice authenticates the caller under standard `@restful` auth.
   * Call before {@link #process} / {@link #health}; each call refreshes the token with the current caller's.
   */
  initialize: function() js-rhino

  /**
   * Checks whether the Doc AI microservice is deployed and reachable on the cluster. Intended to gate
   * Doc AI features in the UI/backend. Never throws: returns `false` if the service is unreachable or
   * responds with a non-success status.
   *
   * @return `true` if the microservice responds successfully to a health check, `false` otherwise.
   */
  isDeployed: function(): boolean js-rhino

  /**
   * Convenience entry point for the Data Fusion strategy picker: initializes the client (base URL + auth)
   * and returns the microservice's OOTB strategies. Custom app-owned strategies are read separately from
   * {@link Genai.DocAiStrategy}; the UI unions the two.
   *
   * @return `[{ name, description, isCustom, scoped, defaultSettings }]`.
   */
  strategies: function(): !json js-rhino
}

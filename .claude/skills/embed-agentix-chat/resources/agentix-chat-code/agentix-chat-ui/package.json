{
  "name": "@c3/agentix-client-ui",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared Nexus chat UI (ChatPage cluster) for the host SPA. Exposes ChatPage, NexusChatTransport, InClusterTransport.",
  "c3ShipUiContent": false,
  "c3ShipDemoUiContent": true,
  "publishConfig": {
    "registry": "https://us-npm.pkg.dev/cicd-360621/npm/"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tailwind-sources.css": "./src/tailwind-sources.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "style": "./src/tailwind-sources.css",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && bash scripts/verify-pack-isolation.sh",
    "build:embed-css": "bash scripts/build-embed-css.sh",
    "build:demo": "npm run build:embed-css && tsc --noEmit -p demo/tsconfig.json && vite build -c demo/vite.demo.config.ts && node demo/demo/postBuild.cjs",
    "build:demo:dev": "npm run build:embed-css && tsc --noEmit -p demo/tsconfig.json && vite build -c demo/vite.demo.config.ts --minify false --sourcemap && node demo/demo/postBuild.cjs",
    "dev:demo": "npm run build:embed-css && vite -c demo/vite.demo.config.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "verify:pack": "bash scripts/verify-pack-isolation.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.101.1",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-bubble-menu": "3.30.5",
    "@tiptap/extension-character-count": "3.30.5",
    "@tiptap/extension-floating-menu": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-placeholder": "3.30.5",
    "@tiptap/extension-task-item": "3.30.5",
    "@tiptap/extension-task-list": "3.30.5",
    "@tiptap/markdown": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "ace-builds": "^1.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.13",
    "driver.js": "^1.4.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": "4.3.2",
    "lucide-react": "^1.21.0",
    "marked": "^18.0.4",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.386.8",
    "radix-ui": "^1.6.0",
    "react-ace": "^14.0.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "i18next": "^26.3.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-i18next": "^17.0.8",
    "react-router": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "~18.3.0",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-istanbul": "3.2.6",
    "i18next": "^26.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "react-router": "^7.5.2",
    "sass": "^1.86.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.7.0",
    "vite": "^6.4.3",
    "vitest": "3.2.6"
  },
  "overrides": {
    "ws": "8.21.0",
    "form-data": "4.0.6",
    "esbuild": "0.25.0",
    "postcss": "8.5.23",
    "@babel/core": "7.29.6",
    "fast-xml-parser": "5.10.1",
    "immutable": "5.1.8",
    "fast-uri": "3.1.6",
    "@hono/node-server": "2.0.10",
    "brace-expansion": "5.0.9",
    "minimatch": "^10.2.6",
    "test-exclude": "^8.0.0",
    "ip-address": "10.3.1",
    "hono": "4.13.5",
    "qs": "6.16.0"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      // No `@/*` alias. Shipped `src/` uses package-relative imports ONLY, so it type-checks under
      // any consumer's tsconfig regardless of their own `@/*` mapping. Deliberately absent so a
      // reintroduced `@/` specifier fails `tsc --noEmit` here (and vite) in-repo instead of
      // shipping and breaking every downstream consumer. See the package-boundary guard.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vitest/globals", "node", "vite/client"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}

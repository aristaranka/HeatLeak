{
  // Build/CI type-check config. `tsconfig.json` remains the editor/IDE config (it keeps the
  // `@/*` second leg and `@c3/agentix-client-ui` mapped to the vendored library source so
  // IntelliSense resolves the real library types).
  //
  // Here we deliberately SCOPE the type-check to the consumer's OWN `src/**`. The vendored
  // library at `../agentix-chat-ui/src/**` ships pre-type-checked from its own repo and is NOT
  // re-checked here — its bare imports (react-i18next, lucide-react, @tanstack/react-query, …)
  // can't resolve in the deploy layout where the library has no node_modules, and re-checking it
  // is not the consumer's job. So we:
  //   1. override `paths` to drop the legs that resolve into library SOURCE
  //      (the `@/*` fallback into `../agentix-chat-ui/src/*`, and `@c3/agentix-client-ui[/*]`), and
  //   2. supply build-only ambient stubs (build-types/) so the consumer's imports of those
  //      modules still resolve to an opaque `any` — keeping the consumer's src type-checked
  //      without pulling the library into the program.
  // Runtime resolution of these imports is handled by vite (vite.config.mts), not by tsc; tsc
  // here only gates the consumer's own code. `strict` and full checking of `src/**` are retained.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@c3/agentix-client-ui": ["./build-types/vendored-library.d.ts"],
      "@c3/agentix-client-ui/*": ["./build-types/vendored-library.d.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "build-types"],
  "exclude": [
    "../agentix-chat-ui/**",
    "node_modules",
    "dist",
    "tests",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**"
  ]
}

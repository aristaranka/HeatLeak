/**
 * A single candidate thermal anomaly: one suspicious region detected inside a
 * {@link ThermalInspection}'s image, paired with an AI-written cautious explanation.
 *
 * The bounding box ({@link ThermalAnomaly#xPct} …) is derived from the actual image
 * pixels on the client; the prose fields ({@link ThermalAnomaly#observation} …) are
 * generated by {@link ThermalInspection#analyze}. A recorded anomaly is a
 * **screening observation to verify**, not a confirmed defect.
 */
entity type ThermalAnomaly schema name 'HL_ANOMALY' {

  /**
   * The owning {@link ThermalInspection}. Inverse of
   * {@link ThermalInspection#anomalies}.
   */
  inspection: !ThermalInspection

  /**
   * Zero-based order of this anomaly within its inspection, used to label markers
   * ("#1", "#2", …) consistently between the image and the findings list.
   */
  anomalyIndex: !int

  /**
   * Short category label, e.g. 'Window-frame thermal contrast',
   * 'Possible thermal bridging', 'Door-seal irregularity',
   * 'Wall/ceiling temperature pattern', or 'Ambiguous thermal pattern'.
   */
  category: !string

  /**
   * Whether the region reads warmer ('hot') or cooler ('cold') than its
   * surroundings in the image.
   */
  polarity: !string

  /**
   * Bounding-box left edge as a fraction (0..1) of image width.
   */
  xPct: !double

  /**
   * Bounding-box top edge as a fraction (0..1) of image height.
   */
  yPct: !double

  /**
   * Bounding-box width as a fraction (0..1) of image width.
   */
  wPct: !double

  /**
   * Bounding-box height as a fraction (0..1) of image height.
   */
  hPct: !double

  /**
   * Signed deviation of the region from the image's mean thermal score, normalized
   * to roughly -1..1 (positive = hotter than average, negative = cooler).
   */
  relativeIntensity: !double

  /**
   * Fraction (0..1) of the total image area covered by this region.
   */
  areaPct: !double

  /**
   * Human-readable location within the frame, e.g. 'upper-left' or 'center'.
   */
  locationLabel: !string

  /**
   * What the image visually shows at this region (AI-written, descriptive only).
   */
  observation: !string

  /**
   * Possible building-related causes for the pattern (AI-written).
   */
  possibleCauses: !string

  /**
   * Alternative, non-defect explanations that could produce a similar pattern —
   * reflections, emissivity differences, camera palette artifacts (AI-written).
   */
  alternativeExplanations: !string

  /**
   * Recommended next verification step before drawing any conclusion (AI-written).
   */
  verificationStep: !string

  /**
   * Qualitative priority for following up this finding: 'Low', 'Medium', or 'High'.
   */
  priority: !string

  /**
   * True when the model judged this candidate is not a building-envelope pattern
   * (sky, vegetation, a reflection, …). The box is kept so the UI can show it greyed.
   */
  rejected: boolean

  /**
   * One sentence from the model naming what the rejected region actually is, e.g.
   * 'Open sky above the roofline, not a building surface.'
   */
  rejectionReason: string

  /**
   * How this region was found: 'cv' = proposed by the client pixel scout (null and
   * the older 'auto' mean the same), 'vision' = added by the model after reviewing
   * the image, 'manual' = drawn by the inspector and then interpreted by the AI.
   */
  source: string

  /**
   * Optional free-text note the inspector attached to this region.
   */
  inspectorNote: string
}

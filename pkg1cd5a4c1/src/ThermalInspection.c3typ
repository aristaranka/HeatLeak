/**
 * One thermal inspection: a session in which a user uploaded an infrared thermal
 * image of a building and ran HeatLeak AI's assisted anomaly screening on it.
 *
 * The uploaded image is stored on the record ({@link ThermalInspection#originalImage})
 * together with the AI-written {@link ThermalInspection#summary} and the individual
 * {@link ThermalAnomaly} findings reachable through {@link ThermalInspection#anomalies}.
 *
 * All results are **preliminary screening observations requiring verification** — a
 * thermal anomaly is not a confirmed building defect.
 */
entity type ThermalInspection schema name 'HL_INSPECTION' {

  /**
   * A short human label for the inspection (defaults to the building name + date).
   */
  name: !string

  /**
   * The {@link Building} this inspection belongs to. Optional so an inspection can
   * be captured against a free-text {@link ThermalInspection#buildingName} before a
   * formal Building record exists; the app normally finds-or-creates the Building.
   */
  building: Building

  /**
   * Denormalized building name as entered on the inspection form, kept on the
   * record so reports render without a join.
   */
  buildingName: string

  /**
   * Denormalized building type (Residential/Commercial/Industrial/Institutional).
   */
  buildingType: string

  /**
   * When the inspection was performed.
   */
  inspectionDate: datetime

  /**
   * Workflow status. One of 'Needs Review', 'Under Investigation', 'Verified',
   * or 'Resolved'.
   */
  status: string

  /**
   * Optional inspector notes captured on the upload form.
   */
  notes: string

  /**
   * Optional indoor air temperature at inspection time, in degrees Celsius.
   */
  indoorTempC: double

  /**
   * Optional outdoor air temperature at inspection time, in degrees Celsius.
   */
  outdoorTempC: double

  /**
   * The actual uploaded thermal image, stored as a base64 `data:` URL so it can be
   * rendered directly in the browser. This is the real user-provided image — never
   * a stock substitute.
   */
  originalImage: string

  /**
   * A base64 `data:` URL of the thermal image with candidate-anomaly bounding boxes
   * drawn on it, produced from the detected regions for the printable report.
   */
  annotatedImage: string

  /**
   * Pixel width of the uploaded image.
   */
  imageWidth: int

  /**
   * Pixel height of the uploaded image.
   */
  imageHeight: int

  /**
   * AI-generated plain-language summary of the overall observations for this
   * inspection, written with cautious, verification-oriented framing.
   */
  summary: string

  /**
   * Qualitative inspection priority derived from the findings: 'Low', 'Medium',
   * or 'High'. Not a quantitative energy estimate.
   */
  priority: string

  /**
   * Number of candidate {@link ThermalAnomaly} regions recorded for this inspection.
   */
  anomalyCount: int

  /**
   * True once {@link ThermalInspection#analyze} has run and findings exist.
   */
  analyzed: boolean

  /**
   * What produced the finding text: 'vision' = the model saw the full image,
   * 'text' = the model saw only the grid and region statistics, 'template' = the
   * LLM call failed and template text was used.
   */
  explanationSource: string

  /**
   * True for clearly-labeled synthetic demonstration inspections generated by the
   * app's demo loader, so they can be visually distinguished from real analyses.
   */
  isDemo: boolean

  /**
   * All candidate anomalies found in this inspection. Inverse of
   * {@link ThermalAnomaly#inspection}.
   */
  anomalies: [ThermalAnomaly](inspection)

  /**
   * Review the candidate thermal regions that the client pixel scout detected from
   * the uploaded image, and persist the verdicts as {@link ThermalAnomaly} records.
   *
   * The model receives the full {@link ThermalInspection#originalImage}, a crop per
   * candidate and a coarse apparent-temperature grid (when the C3 completion client
   * passes images through; otherwise the grid and region statistics only). For every
   * candidate it decides `keep` or `reject` — rejected regions (sky, vegetation,
   * reflections, …) are stored with {@link ThermalAnomaly#rejected} and a
   * {@link ThermalAnomaly#rejectionReason} — writes a specific, spatial explanation
   * for each keeper, and may add up to two further findings
   * ({@link ThermalAnomaly#source} = 'vision'). Anomalies are persisted in display
   * order (kept scout regions, model additions, then rejected) with a contiguous
   * {@link ThermalAnomaly#anomalyIndex}. It then sets the overall
   * {@link ThermalInspection#summary} and {@link ThermalInspection#priority},
   * {@link ThermalInspection#anomalyCount} (non-rejected only),
   * {@link ThermalInspection#explanationSource}, {@link ThermalInspection#status}
   * to 'Needs Review' and {@link ThermalInspection#analyzed} to true. If the LLM
   * call fails, template text is used and `explanationSource` is 'template'.
   *
   * @param regionsJson JSON payload `{regions, gridText, gridW, gridH}` where each
   *   region has `xPct`,`yPct`,`wPct`,`hPct` (bounding box as fractions of the
   *   image), `polarity` ('hot'|'cold'), `relativeIntensity` (signed -1..1),
   *   `areaPct`, `locationLabel` and an optional `crop` data URL; `gridText` is
   *   rows of digits 0–9 (top row first), `gridW`/`gridH` its dimensions. A legacy
   *   bare JSON array of regions is also accepted.
   * @return This inspection, updated with its new findings.
   */
  analyze: member function(regionsJson: string): ThermalInspection py
}
